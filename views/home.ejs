<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Library Management System</title>

<style>
    :root {
        --primary: #6366f1;
        --success: #22c55e;
        --danger: #ef4444;
        --warning: #f59e0b;
        --bg: #f8fafc;
        --card: #ffffff;
        --text: #1f2937;
    }

    * {
        box-sizing: border-box;
        font-family: "Segoe UI", sans-serif;
    }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
    }

    header {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white;
        padding: 30px;
        text-align: center;
    }

    header h1 {
        margin: 0;
        font-size: 2.2rem;
    }

    .container {
        max-width: 1100px;
        margin: auto;
        padding: 30px;
    }

    h2 {
        margin-bottom: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }

    th {
        background: #eef2ff;
        text-align: left;
        padding: 14px;
        font-weight: 600;
    }

    td {
        padding: 14px;
        border-bottom: 1px solid #e5e7eb;
    }

    tr:last-child td {
        border-bottom: none;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
    }

    .available {
        background: #dcfce7;
        color: #166534;
    }

    .issued {
        background: #fee2e2;
        color: #7f1d1d;
    }

    button {
        border: none;
        padding: 7px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
    }

    .btn-issue {
        background: var(--warning);
        color: white;
    }

    .btn-return {
        background: var(--success);
        color: white;
    }

    .btn-delete {
        background: var(--danger);
        color: white;
    }

    button:hover {
        opacity: 0.9;
    }

    .add-book {
        margin-top: 40px;
        background: var(--card);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    input {
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #d1d5db;
        font-size: 0.9rem;
    }

    .add-btn {
        margin-top: 15px;
        background: var(--primary);
        color: white;
        padding: 10px;
        width: 160px;
        font-size: 0.9rem;
    }

    footer {
        text-align: center;
        padding: 20px;
        font-size: 0.85rem;
        color: #6b7280;
    }

    @media (max-width: 768px) {
        table {
            font-size: 0.85rem;
        }
    }
</style>
</head>

<body>

<header>
    <h1>📚 Library Management System</h1>
    <p>Smart • Simple • Modern</p>
</header>

<div class="container">

    <h2>All Books</h2>

    <table>
        <tr>
            <th>Book</th>
            <th>Author</th>
            <th>Pages</th>
            <th>Price</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>

        <% data.forEach(book => { %>
        <tr>
            <td><strong><%= book.bookName %></strong></td>
            <td><%= book.bookAuthor %></td>
            <td><%= book.bookPages %></td>
            <td>₹ <%= book.bookPrice %></td>
            <td>
                <span class="badge <%= book.bookState === 'Available' ? 'available' : 'issued' %>">
                    <%= book.bookState %>
                </span>
            </td>
            <td>
                <% if (book.bookState === "Available") { %>
                    <form action="/issue" method="post" style="display:inline">
                        <input type="hidden" name="bookName" value="<%= book.bookName %>">
                        <button class="btn-issue">Issue</button>
                    </form>
                <% } %>

                <% if (book.bookState === "Issued") { %>
                    <form action="/return" method="post" style="display:inline">
                        <input type="hidden" name="bookName" value="<%= book.bookName %>">
                        <button class="btn-return">Return</button>
                    </form>
                <% } %>

                <form action="/delete" method="post" style="display:inline">
                    <input type="hidden" name="bookName" value="<%= book.bookName %>">
                    <button class="btn-delete">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </table>

    <div class="add-book">
        <h2>Add New Book</h2>

        <form action="/" method="post">
            <div class="form-grid">
                <input type="text" name="bookName" placeholder="Book Name" required>
                <input type="text" name="bookAuthor" placeholder="Author Name" required>
                <input type="number" name="bookPages" placeholder="Pages" required>
                <input type="number" name="bookPrice" placeholder="Price" required>
            </div>

            <button class="add-btn">Add Book</button>
        </form>
    </div>

</div>

<footer>
    © 2026 Library Management System
</footer>

</body>
</html>
